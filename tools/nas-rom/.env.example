# Copy to .env; replace both empty paths before running Docker Compose.
# Use absolute paths on the NAS itself, not Windows UNC or Mac mount paths.
# The existing ROM directory must not contain REPORT_DIR or this app directory.
ROM_ROOT=
REPORT_DIR=

# Existing JSON file, relative to compose.yaml or an absolute NAS path.
CONFIG_FILE=./config.json

# Run `id -u` and `id -g` as the NAS account that can read your ROMs and
# write the report directory. Match these values before the first build/run.
NAS_UID=1000
NAS_GID=1000
